
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

# ========== 关键：限制只编译指定设备 ==========
CONFIG_TARGET_ALL_PROFILES=n      # 添加这一行
CONFIG_TARGET_MULTI_PROFILE=n     # 添加这一行
CONFIG_TARGET_PER_DEVICE_ROOTFS=n # 可选，进一步减少体积

# 明确指定只编译 360T7
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_360t7=y

# 显式禁用其他设备
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cudy_re3000-v1=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cudy_wr3000-v1=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_yuncore_ax835=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-stock=n


CONFIG_PACKAGE_kmod-pcie_mhi=m

# ========== 固件格式配置 ==========
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
CONFIG_TARGET_UBIFS_FREE_SPACE_FIXUP=y

# 生成 sysupgrade 镜像
CONFIG_TARGET_IMAGE_SYSUPGRADE=y

# 可选：同时生成 factory 镜像（用于从原厂刷机）
CONFIG_TARGET_IMAGE_FACTORY=n

# 禁用 initramfs（除非你需要急救系统）
CONFIG_TARGET_ROOTFS_INITRAMFS=n

# DAE
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_REDUCED=n
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_BPF_TOOLCHAIN_HOST=y
CONFIG_KERNEL_XDP_SOCKETS=y


# ========== 禁用 perf 和相关工具 ==========
CONFIG_PACKAGE_perf=n
CONFIG_PACKAGE_perf-archive=n
CONFIG_KERNEL_PERF_EVENTS=n
CONFIG_DEVEL_PERF=n
