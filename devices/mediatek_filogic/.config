# ========== 基础平台配置 ==========
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

# ========== 设备选择（关键）==========
CONFIG_TARGET_ALL_PROFILES=n
CONFIG_TARGET_MULTI_PROFILE=n
CONFIG_TARGET_PER_DEVICE_ROOTFS=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_qihoo_360t7=y

# ========== 固件格式（生成 sysupgrade）==========
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
CONFIG_TARGET_UBIFS_FREE_SPACE_FIXUP=y
CONFIG_TARGET_IMAGE_SYSUPGRADE=y          # 生成 sysupgrade.bin
CONFIG_TARGET_ROOTFS_INITRAMFS=n          # 禁用 initramfs（减少体积）

# ========== 分区大小 ==========
CONFIG_TARGET_ROOTFS_PARTSIZE=512         # 512MB 足够

# ========== 可选驱动 ==========
CONFIG_PACKAGE_kmod-pcie_mhi=m

# ========== DAE/BFP 支持（如需 OpenClash TProxy）==========
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_REDUCED=n
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_BPF_TOOLCHAIN_HOST=y
CONFIG_KERNEL_XDP_SOCKETS=y



# ========== HomeProxy 配置 ==========
# 核心依赖（会自动选中）
#CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_kmod-nft-tproxy=y

# HomeProxy 主程序和界面
CONFIG_PACKAGE_luci-app-homeproxy=y

# 可选：一些常用的规则集文件，方便首次使用
# CONFIG_PACKAGE_v2ray-geoip=y
# CONFIG_PACKAGE_v2ray-geosite=y


# ========== 禁用不需要的包 ==========
CONFIG_PACKAGE_perf=n
CONFIG_PACKAGE_perf-archive=n
CONFIG_KERNEL_PERF_EVENTS=n
CONFIG_DEVEL_PERF=n

# ========== 可选：禁用 Docker（减少体积）==========
CONFIG_PACKAGE_dockerd=n
CONFIG_PACKAGE_docker-compose=n
CONFIG_KERNEL_CGROUP_DEVICE=n
CONFIG_KERNEL_CGROUP_FREEZER=n
CONFIG_KERNEL_NET_CLS_CGROUP=n
CONFIG_KERNEL_CGROUP_NET_PRIO=n
CONFIG_KERNEL_MEMCG_SWAP_ENABLED=n
CONFIG_KERNEL_CFQ_GROUP_IOSCHED=n
CONFIG_KERNEL_CGROUP_PERF=n
CONFIG_KERNEL_CGROUP_HUGETLB=n




# 1. 启用版本配置选项
CONFIG_VERSIONOPT=y

# 2. 设置发行版名称（保持你喜欢的名称，如 Kwrt）
CONFIG_VERSION_DIST="Kwrt"

# 3. 【核心修改】将版本号设置为具体的稳定版，例如 24.10.1
#    可以设置为 24.10.1, 24.10.0 等，或者直接用分支名 "24.10"
#    注意：不要带 -SNAPSHOT 后缀
CONFIG_VERSION_NUMBER="24.10.5"

# 4. （可选）设置制造商信息
CONFIG_VERSION_MANUFACTURER="holyhbc"




